<Window x:Class="Soundforge.ProjectProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Soundforge project"
        Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Background="#202228" Foreground="#F2F2F2">
    <Border Padding="22">
        <StackPanel>
            <TextBlock x:Name="HeadingText" FontSize="20" FontWeight="Bold"/>
            <TextBlock x:Name="StageText" Margin="0,12,0,6" FontWeight="SemiBold"/>
            <ProgressBar x:Name="OperationProgress" Height="20" Minimum="0" Maximum="100"/>
            <TextBlock x:Name="DetailText" Margin="0,8,0,0" Foreground="#C8CCD6"
                       TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="PercentageText" Margin="0,5,0,0" Foreground="#9FD0FF"/>
        </StackPanel>
    </Border>
</Window>
