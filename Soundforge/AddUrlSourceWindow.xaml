<Window x:Class="Soundforge.AddUrlSourceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add cloud audio" SizeToContent="WidthAndHeight" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner" Background="#202228" Foreground="#F2F2F2">
    <StackPanel Margin="18" Width="540">
        <TextBlock Text="CLOUD AUDIO LINKS" FontWeight="Bold"/>
        <TextBlock Margin="0,5,0,10" TextWrapping="Wrap"
                   Text="Paste one link per line, or paste Google's comma-separated list. Soundforge downloads every successful file into its local cache before adding it. Direct HTTPS audio URLs and publicly downloadable Google Drive file links are supported."/>
        <TextBox x:Name="UrlText" MinHeight="180" MaxHeight="420" Padding="5"
                 AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"/>
        <TextBlock Text="Optional display name (single link only)" Margin="0,14,0,4"/>
        <TextBox x:Name="NameText" MinHeight="30" Padding="5"/>
        <TextBlock Margin="0,12,0,0" Foreground="#9FD0FF" TextWrapping="Wrap"
                   Text="Private Drive files require Google sign-in, planned for a later build. Network audio is never streamed during playback."/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel" IsCancel="True" Padding="14,6"/>
            <Button Content="Download and Add All" IsDefault="True" Padding="14,6" Margin="8,0,0,0" Click="Accept_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
