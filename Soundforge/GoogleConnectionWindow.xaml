<Window x:Class="Soundforge.GoogleConnectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Google Drive connection — 0.9a.4 proof of concept" Width="610" Height="540"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="20">
        <TextBlock Text="Connect Google Drive" FontSize="22" FontWeight="Bold"/>
        <TextBlock Margin="0,10" TextWrapping="Wrap" Text="Sign in using your system browser. This phase tests authentication only; Drive browsing comes next. Existing audio playback is independent of this connection."/>
        <Button x:Name="ConfigureButton" Content="Import Google Desktop client JSON…" Click="Configure_Click" Padding="8" HorizontalAlignment="Left"/>
        <TextBlock x:Name="ConfigurationText" Margin="0,5,0,10" TextWrapping="Wrap"/>
        <TextBlock Text="Credential storage"/>
        <ComboBox x:Name="StorageChoice" SelectedIndex="0" Margin="0,4,0,8">
            <ComboBoxItem Content="Passphrase encrypted (recommended for Proton)"/>
            <ComboBoxItem Content="Windows user protection (native Windows only)"/>
            <ComboBoxItem Content="Session only (not saved)"/>
        </ComboBox>
        <TextBlock Text="Credential passphrase — at least 12 characters; not your Google password"/>
        <PasswordBox x:Name="PassphraseBox" Margin="0,4,0,12"/>
        <WrapPanel>
            <Button x:Name="ConnectButton" Content="Connect Google Drive" Click="Connect_Click" Padding="8"/>
            <Button x:Name="ReconnectButton" Content="Reconnect saved account" Click="Reconnect_Click" Padding="8" Margin="6,0"/>
            <Button x:Name="DisconnectButton" Content="Disconnect" Click="Disconnect_Click" Padding="8"/>
            <Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click" Padding="8" Margin="6,0" IsEnabled="False"/>
        </WrapPanel>
        <TextBlock x:Name="StatusText" Text="Disconnected" Margin="0,15,0,0" TextWrapping="Wrap"/>
        <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Text="Disconnect removes saved tokens, not cached audio. Closing this window ends session-only authentication. Saved credentials require Reconnect after reopening."/>
    </StackPanel>
    </ScrollViewer>
</Window>
