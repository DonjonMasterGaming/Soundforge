<Window x:Class="Soundforge.TrackEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit source playback range"
        Width="500" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Background="#202228" Foreground="#F2F2F2">
    <Window.Resources>
        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="#F2F2F2"/>
        </Style>
    </Window.Resources>
    <Border Padding="22">
        <StackPanel>
            <TextBlock Text="EDIT SOURCE" FontSize="20" FontWeight="Bold"/>
            <TextBlock x:Name="TrackNameText" Margin="0,8,0,0" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock x:Name="DurationText" Margin="0,5,0,18" Foreground="#C8CCD6"/>

            <TextBlock Text="Start time (seconds or minutes:seconds)" Margin="0,0,0,4"/>
            <TextBox x:Name="StartTimeText" Height="30" Padding="5"/>
            <TextBlock Text="End time (seconds or minutes:seconds)" Margin="0,12,0,4"/>
            <TextBox x:Name="EndTimeText" Height="30" Padding="5"/>

            <TextBlock Text="The original audio file will not be changed. Music advances and ambience loops at these markers."
                       Margin="0,16,0,0" Foreground="#9FD0FF" TextWrapping="Wrap"/>
            <TextBlock x:Name="ValidationText" Margin="0,10,0,0" Foreground="#FF9B9B" TextWrapping="Wrap"/>

            <WrapPanel HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Reset to Full Track" Padding="10,6" Click="Reset_Click"/>
                <Button Content="Cancel" Padding="10,6" Margin="8,0,0,0" IsCancel="True"/>
                <Button Content="Save" Padding="14,6" Margin="8,0,0,0" IsDefault="True" Click="Save_Click"/>
            </WrapPanel>
        </StackPanel>
    </Border>
</Window>
