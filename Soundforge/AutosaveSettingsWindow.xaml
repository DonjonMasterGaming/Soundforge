<Window x:Class="Soundforge.AutosaveSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Autosave settings"
        Width="570" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Background="#202228" Foreground="#F2F2F2">
    <Window.Resources>
        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="#F2F2F2"/>
        </Style>
        <Style TargetType="{x:Type CheckBox}">
            <Setter Property="Foreground" Value="#F2F2F2"/>
        </Style>
    </Window.Resources>
    <Border Padding="22">
        <StackPanel>
            <TextBlock Text="AUTOSAVE &amp; CRASH RECOVERY" FontSize="20" FontWeight="Bold"/>
            <TextBlock Text="Autosaves contain project settings and source locations, not duplicate audio files."
                       Margin="0,8,0,18" Foreground="#9FD0FF" TextWrapping="Wrap"/>

            <CheckBox x:Name="EnabledCheckBox" Content="Enable automatic crash-recovery saves" FontWeight="SemiBold"/>

            <TextBlock Text="Save every (minutes)" Margin="0,16,0,4"/>
            <TextBox x:Name="IntervalText" Width="100" Height="30" Padding="5" HorizontalAlignment="Left"/>

            <TextBlock Text="Autosave folder" Margin="0,16,0,4"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="FolderText" Height="30" Padding="5"/>
                <Button Grid.Column="1" Content="Browse…" Padding="10,5" Margin="8,0,0,0" Click="Browse_Click"/>
            </Grid>

            <TextBlock x:Name="ValidationText" Margin="0,10,0,0" Foreground="#FF9B9B" TextWrapping="Wrap"/>
            <WrapPanel HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Use Default Folder" Padding="10,6" Click="DefaultFolder_Click"/>
                <Button Content="Cancel" Padding="10,6" Margin="8,0,0,0" IsCancel="True"/>
                <Button Content="Save Settings" Padding="14,6" Margin="8,0,0,0" IsDefault="True" Click="Save_Click"/>
            </WrapPanel>
        </StackPanel>
    </Border>
</Window>
